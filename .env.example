# Dani Tech — Environment Variables Reference
#
# Copy this file to .env and fill in real values before deploying.
# Never commit .env to version control (it is already in .gitignore).

# ─── App URL ────────────────────────────────────────────────────────────────
# The public URL where this app is hosted.
VITE_APP_URL="https://danitech.vercel.app"

# ─── Firebase Firestore (REQUIRED for product persistence) ──────────────────
# Get these values from Firebase Console → Project Settings → Your Apps → Web App
# All 6 values below are required. Set them in Vercel → Environment Variables.
VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
