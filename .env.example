# Dani Tech — Environment Variables Reference
#
# Copy this file to .env and fill in real values before deploying.
# Never commit .env to version control (it is already in .gitignore).

# ─── App URL ────────────────────────────────────────────────────────────────
# The public URL where this app is hosted.
# Used for canonical links and Open Graph tags in index.html.
# Example: https://danitech.vercel.app or https://danitechgh.com
VITE_APP_URL="https://danitech.vercel.app"

# ─── Gemini AI (Optional) ───────────────────────────────────────────────────
# Only required if AI-powered features are enabled.
# GEMINI_API_KEY="your-api-key-here"
